      const em = makeEmitter(zipMode);
      const n = await exportAll(results, sel, fmt, delim, perApp, perCat, em, runStamp);
      if (errs.length) await em.emit(`qlik_errors_${runStamp}.txt`, '\uFEFF' + errs.map(r => `${r.appId}|${r.appName || ''}|${r.error}`).join('\r\n'), 'text/plain');
      const packed = em.finish(runStamp);
      log(zipMode
        ? `Готово. В ZIP-архиве файлов: ${packed}. Ошибок: ${errs.length}.`
        : `Готово. Скачано файлов: ${n + (errs.length ? 1 : 0)}. Ошибок: ${errs.length}.`);
      if (errs.length) log('С ошибками: ' + errs.map(r => (r.appName || r.appId) + ' (' + r.error + ')').join('; '));
    } catch (e) { log('СБОЙ: ' + (e.message || e)); }
    finally {
      $('#qme-run').disabled = false; $('#qme-stop').disabled = true;
      $('#qme-retry').disabled = !LAST_FAILED.length;
      if (LAST_FAILED.length) log(`Кнопка «Повтор ошибок» перегонит ${LAST_FAILED.length} сбойных приложений с текущими настройками.`);
    }
  }

  $('#qme-run').onclick = () => runExport(null);
  $('#qme-retry').onclick = () => { if (LAST_FAILED.length) runExport(LAST_FAILED.slice()); };

  log('Панель готова. Настрой и нажми «Запуск».');
})();
